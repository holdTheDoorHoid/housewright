{
  "name": "housewright-app",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../web --target web --out-dir pkg --release",
    "dev": "vite",
    "dev:web": "npm run wasm && vite --mode web",
    "build": "vite build",
    "build:web": "npm run wasm && vite build --mode web",
    "preview:web": "vite preview --mode web --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.4",
    "jsdom": "^31.0.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  }
}
