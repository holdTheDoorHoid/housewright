          "tasks": [
            {
              "completion_fields": [
                {
                  "key": "result",
                  "label": "Result",
                  "options": [
                    "pass",
                    "fail"
                  ],
                  "sensitivity": "normal",
                  "type": "choice"
                }
              ],
              "key": "test",
              "minutes": 2,
              "priority": "life_safety",
              "schedule": {
                "every": "1 month",
                "kind": "fixed"
              },
              "source": "NFPA guidance",
              "steps": [
                "Tell everyone at home you are about to test the alarm.",
                "Press and hold the test button until the alarm sounds.",
                "If it stays silent or sounds weak, replace the battery and test again.",
                "If it still fails, replace the alarm."
              ],
              "title": "Test the smoke alarm",
              "why": "A working alarm gives you the minutes you need to get out in a fire."
            },
            {
              "key": "battery",
              "minutes": 5,
              "priority": "life_safety",
              "schedule": {
                "every": "1 year",
                "kind": "fixed"
              },
              "source": "NFPA guidance",
              "steps": [
                "Have the right replacement battery ready.",
                "Twist or slide the alarm off its base.",
                "Swap the battery, matching the + and - marks.",
                "Refit the alarm and press the test button."
              ],
              "title": "Replace the smoke alarm battery",
              "when": {
                "equals": "battery",
                "field": "power"
              },
              "why": "A low battery is the most common reason an alarm fails when it is needed."
            },
            {
              "key": "replace",
              "minutes": 20,
              "priority": "life_safety",
              "schedule": {
                "every": "10 years",
                "kind": "floating"
              },
              "source": "NFPA guidance",
              "steps": [
                "Check the date of manufacture on the back of the alarm.",
                "Buy a replacement of the same type (and the same connector if hardwired).",
                "For a hardwired alarm, switch off its circuit at the breaker first.",
                "Fit the new alarm, restore power and press the test button.",
                "Write the install date on the new alarm."
              ],
              "title": "Replace the smoke alarm (ten-year life)",
              "why": "Smoke sensors wear out; alarms are meant to be replaced about every ten years."
            },
            {
              "key": "clean",
              "minutes": 5,
              "priority": "life_safety",
              "schedule": {
                "every": "6 months",
                "kind": "fixed"
              },
              "source": "common manufacturer guidance",
              "steps": [
                "Use the soft brush attachment of a vacuum.",
                "Gently vacuum the vents around the alarm cover.",
                "Do not paint over or cover the alarm.",
                "Press the test button afterwards."
              ],
              "title": "Vacuum the smoke alarm vents",
              "why": "Dust in the sensing chamber causes false alarms, which tempt people to disable alarms."
            }
          ]
        }
      }
    ],
